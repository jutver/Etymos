{
  "name": "etymos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @etymos/web",
    "dev:admin": "npm run dev -w @etymos/admin",
    "build:web": "npm run build -w @etymos/web",
    "build:admin": "npm run build -w @etymos/admin",
    "lint": "oxlint apps/*/src packages/*/src"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2"
  }
}
